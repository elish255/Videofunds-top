# Firebase Web API key (Firebase Console > Project settings > General)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=videofunds-project

# Firebase Admin SDK service-account JSON, pasted as ONE LINE JSON.
# Never commit the real service-account file or JSON value to Git.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis-compatible URL for persistent PHP sessions on Vercel.
# Example: redis://default:YOUR_PASSWORD@YOUR_HOST:6379/0
REDIS_URL=

# Payment credentials: rotate old exposed keys before setting these values.
PAYMENT_ACCESS_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_API_URL=
PAYMENT_STATUS_URL=
PAYMENT_MERCHANT_ID=23513043
