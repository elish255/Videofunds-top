rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owner(uid);
      // This is a transitional policy for the existing PHP application. Before production,
      // migrate all balance/earning writes to trusted server endpoints and tighten this rule.
      allow create, update: if owner(uid);
      allow delete: if false;
      match /pending_bonuses/{bonusId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
    match /notifications/{noticeId} {
      allow read: if signedIn() && (resource.data.target_uid == 'ALL' || resource.data.target_uid == request.auth.uid);
      allow write: if false;
    }
    match /admin_audit/{auditId} { allow read, write: if false; }
  }
}
